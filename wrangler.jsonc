// Cloudflare-Konfiguration: liefert den fertigen Build (dist/) als statische Website aus.
// src/worker.js kümmert sich zusätzlich um das Kontaktformular (/api/kontakt).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastlanes-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Adressen ohne Schrägstrich wie bei Webflow (/kontakt), unbekannte Adressen -> 404.html (mit Status 404)
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Kontaktformular – Empfänger und Absender (Absender-Domain muss bei Resend verifiziert sein)
  "vars": {
    "MAIL_TO": "kontakt@fastlanes.de",
    "MAIL_FROM": "FASTLANES Website <website@notify.fastlanes.de>"
  },
  "observability": { "enabled": true }
}
